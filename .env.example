# Copy to .env.local. DO NOT commit real Telegram credentials.
TELEGRAM_BOT_TOKEN=REPLACE_WITH_YOUR_BOT_TOKEN
TELEGRAM_CHAT_ID=REPLACE_WITH_YOUR_CHAT_ID

# One global Telegram dry-run switch (never define twice).
# true = simulated logs; false = real Telegram messages, no Binance orders.
ALERT_DRY_RUN=false
ALERT_POLL_MS=60000
ALERT_SEND_ON_START=false
ALERT_EVENT_ENABLED=true
ALERT_EXTRA_SYMBOLS_ENABLED=true
ALERT_QUICK_ENABLED=true

SENTIMENT_TELEGRAM_ENABLED=true
SENTIMENT_POLL_MINUTES=60

ORDER_FLOW_TELEGRAM_ENABLED=true
ORDER_FLOW_POLL_MINUTES=5

V7_TELEGRAM_ENABLED=true
V7_POLL_MS=60000
V7_SETUP_FORMING_ALERTS=false
V7_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,TAOUSDT,LINKUSDT,BNBUSDT
# Add only VERIFIED future events, with UTC ISO timestamps and official source URLs.
# Example format (do NOT use fictional dates):
# V7_EVENTS_JSON=[{"id":"actual-event-id","name":"Verified event","timeUTC":"YYYY-MM-DDTHH:MM:SSZ","impact":"CRITICAL","source":"https://www.example.gov/event"}]

V71_JOURNAL_POLL_MS=300000
V71_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,TAOUSDT,LINKUSDT,BNBUSDT
V71_JOURNAL_PATH=.signal-alerts/v71-paper-journal.json
