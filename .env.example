# Make a Telegram bot with @BotFather; NEVER commit the token.
TELEGRAM_BOT_TOKEN=your_token_here
# Message your bot, then obtain your numeric chat id via getUpdates.
TELEGRAM_CHAT_ID=your_chat_id_here
# Check every 60 seconds. Worker only evaluates NEW closed candles.
ALERT_POLL_MS=60000
# Set true to log instead of actually messaging Telegram.
ALERT_DRY_RUN=false
# false = do not send alerts from a candle that already closed before the first run
ALERT_SEND_ON_START=false

# Add-on 5m quick alerts. Existing alerts remain active.
ALERT_QUICK_ENABLED=true
# No daily cap on confirmed quick signals.

# Optional advance risk reminders for listed scheduled events (not trade signals).
ALERT_EVENT_ENABLED=true
